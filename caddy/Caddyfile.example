# Copy to caddy/Caddyfile before first run: cp caddy/Caddyfile.example caddy/Caddyfile
#
# Plain HTTP only. TLS terminates at Cloudflare's edge, not here; the tunnel
# forwards to this container on port 80 over the private network, never the
# public internet. See RFC-0001, "Networking and domains".
#
# Ghost is told the original request was HTTPS via the header override
# below, so it generates https:// links even though the connection to Caddy
# itself is plain HTTP.

http://{$DOMAIN} {
	reverse_proxy ghost:2368 {
		header_up X-Forwarded-Proto https
	}
	encode gzip
}

http://{$ADMIN_DOMAIN} {
	reverse_proxy ghost:2368 {
		header_up X-Forwarded-Proto https
	}
	encode gzip
}
