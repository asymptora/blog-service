# Copy to .env, fill in the placeholder values below, then encrypt with SOPS
# before this ever leaves the local machine. .env itself is never committed;
# see AGENTS.md and .gitignore.

# --- Domains ---
# Public site and Ghost Admin, routed by Caddy, both reached through the
# existing Cloudflare Tunnel. See RFC-0001, "Networking and domains".
DOMAIN=blog.asymptora.com
ADMIN_DOMAIN=admin.blog.asymptora.com

# --- Image version ---
# Exact tag, never a floating one. Check for a newer release deliberately,
# as its own pull request, per RFC-0001, "Image versioning".
GHOST_VERSION=6.64.0-alpine

# --- Database ---
# Generate both with: openssl rand -hex 32
# Immutable once the database is initialized; changing these after first
# boot does not rotate the password Ghost or MySQL actually use.
DATABASE_USER=ghost
DATABASE_PASSWORD=changeme_generate_with_openssl_rand_hex_32
DATABASE_ROOT_PASSWORD=changeme_generate_with_openssl_rand_hex_32

# --- Transactional email (Zoho Mail) ---
# App-specific password, generated under the Zoho account's existing 2FA.
mail__transport=SMTP
mail__options__host=smtp.zoho.com
mail__options__port=465
mail__options__secure=true
mail__options__auth__user=noreply@asymptora.com
mail__options__auth__pass=changeme_zoho_app_specific_password
mail__from="Asymptora Blog <noreply@asymptora.com>"

# --- Storage locations (defaults, override only if needed) ---
# UPLOAD_LOCATION=./data/ghost
# MYSQL_DATA_LOCATION=./data/mysql
